DISCORD_TOKEN=replace-with-your-discord-bot-token
PREFIX=r!
# Interface for the health endpoint. Keep 127.0.0.1 when self-hosting;
# Render requires 0.0.0.0 because it probes the service from its router.
HOST=127.0.0.1
PORT=3000
# Per-user, per-server command budget (default: 5 commands per 10 s).
COMMAND_RATE_LIMIT=5
COMMAND_RATE_WINDOW_MS=10000
# Required only for npm run deploy:commands.
CLIENT_ID=your-discord-application-id
GUILD_ID=your-server-id
# For multiple servers, use a comma-separated list instead of GUILD_ID.
# GUILD_IDS=server-id-1,server-id-2
