[Unit]
Description=RixelBot Discord bot
Documentation=https://github.com/rixeldev/rixelbot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=rixelbot
Group=rixelbot
WorkingDirectory=/opt/rixelbot
EnvironmentFile=/etc/rixelbot.env
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/rixelbot/data
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

# Files: the code stays read-only, only the state directory is writable.
StateDirectory=rixelbot
StateDirectoryMode=0750
UMask=0077

# Resource limits: the bot idles well under 150 MB.
MemoryMax=1G
MemoryHigh=512M
TasksMax=256
CPUQuota=50%

# Sandboxing. MemoryDenyWriteExecute is intentionally NOT enabled because the
# V8 JIT needs writable-executable pages.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
