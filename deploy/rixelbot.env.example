# Copy to /etc/rixelbot.env and keep it root:rixelbot 0640.
DISCORD_TOKEN=replace-with-your-discord-bot-token
PREFIX=r!
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/rixelbot/data
COMMAND_RATE_LIMIT=5
COMMAND_RATE_WINDOW_MS=10000
# Optional: Discord webhook used by the monitor to report problems.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
