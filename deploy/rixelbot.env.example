# Copy to /etc/rixelbot.env and keep it root:rixelbot 0640.
DISCORD_TOKEN=replace-with-your-discord-bot-token
PREFIX=r!
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/rixelbot/data
COMMAND_RATE_LIMIT=5
COMMAND_RATE_WINDOW_MS=10000
# Discord webhook used by the bot and the monitor for alerts.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Minimum gap between repeated notices of the same kind, in milliseconds.
# NOTIFY_COOLDOWN_MS=60000
# NOTIFY_GATEWAY_COOLDOWN_MS=300000
# Alert when the whole machine exceeds this many Mbps (0 = disabled, default).
# The bot's own traffic is negligible, so this fires on any large download.
# ALERT_MBPS=200
# Grace before a not-ready (503) bot becomes an alert, in milliseconds.
# HEALTH_GRACE_MS=600000
